# Use qr_print for the application and qr_print_test for integration tests.
# Keep replaced credentials in your local .env only. Atlas URLs must name the database.
MONGODB_URI="mongodb://localhost:27017/qr_print?replicaSet=rs0"
TEST_MONGODB_URI="mongodb://localhost:27017/qr_print_test?replicaSet=rs0"
JWT_SECRET="replace-with-a-long-random-secret"
API_PORT=4000
# Production: exact HTTPS frontend origin(s), comma-separated. Local dev may leave blank.
CORS_ORIGINS="http://localhost:3000"
# Private durable PDF storage. PDF bytes never go to MongoDB.
QRPRINT_STORAGE_DIR="./storage"
# Local uses filesystem; Vercel production requires a connected private Blob store.
QRPRINT_STORAGE_PROVIDER="filesystem"
DOCUMENT_RETENTION_DAYS=30
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Public customer site origin used for generated shop QR codes.
PUBLIC_APP_URL="http://localhost:3000"
PAYMENT_MODE="mock"
# mock payments are development only; production startup rejects this adapter
PRINT_EXECUTION_MODE="simulated"
PRINT_MAX_ATTEMPTS=3
AGENT_LEASE_SECONDS=60
CASH_ORDERS_ENABLED=false
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_OWNER_PASSWORD="replace-with-a-long-random-password"
BOOTSTRAP_SHOP_NAME="My Print Shop"
BOOTSTRAP_SHOP_SLUG="my-print-shop"
# Optional super-admin account
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Windows agent only: set on the agent PC after one-time enrollment.
# QRPRINT_API_URL="http://localhost:4000"
# QRPRINT_AGENT_TOKEN="qpa_<one-time-enrollment-credential>"
# PRINT_AGENT_MODE="simulated"
# Real mode only: configure a trusted PDF renderer and its supported unattended arguments.
# QRPRINT_PDF_PRINT_COMMAND="C:\\Program Files\\SumatraPDF\\SumatraPDF.exe"
# QRPRINT_PDF_PRINT_ARGS="-print-to \"{printer}\" -print-settings \"{duplex}\" \"{file}\""
